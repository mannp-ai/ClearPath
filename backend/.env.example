# ===================================================================
# ClearPath Backend Environment Configuration
# ===================================================================

# Environment mode ('development', 'test', 'production')
NODE_ENV=development
PORT=4000

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/clearpath?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/clearpath
MONGODB_DATABASE=clearpath
MONGODB_MAX_POOL_SIZE=10

# JSON Web Token Secret (minimum 32 characters)
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters

# CORS & Frontend Origins (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
ALLOW_VERCEL_PREVIEWS=false

# Cookie Security ('lax', 'strict', or 'none' for cross-domain production)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Google OAuth 2.0 / OpenID Connect
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Email Delivery Provider ('gmail_oauth2', 'smtp', or 'test')
MAIL_PROVIDER=smtp
EMAIL_FROM=noreply@clearpath.local

# Gmail OAuth2 Configuration (when MAIL_PROVIDER=gmail_oauth2)
GMAIL_USER=your-account@gmail.com
GMAIL_CLIENT_ID=your-gmail-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-gmail-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-oauth-refresh-token

# Standard SMTP Configuration (when MAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
