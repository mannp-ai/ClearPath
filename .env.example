# ===================================================================
# ClearPath Root Environment Configuration Guide
# ===================================================================

# -----------------
# FRONTEND (Next.js)
# -----------------
# Base URL of the backend API (without trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Google OAuth Client ID for frontend button / GIS integration (optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# -----------------
# BACKEND (Node.js / Express)
# -----------------
NODE_ENV=development
PORT=4000

# MongoDB Atlas URI (Use SRV format from Atlas connection modal)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/clearpath?retryWrites=true&w=majority
MONGODB_DATABASE=clearpath

# JWT Secret (minimum 32 characters)
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters

# CORS and Domains
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
COOKIE_SAMESITE=lax

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Email Configuration
MAIL_PROVIDER=smtp
EMAIL_FROM=noreply@clearpath.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
